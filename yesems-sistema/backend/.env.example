PORT=4000
# Principal: PostgreSQL en Neon. Copiar la URL real solo en un entorno privado.
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require
NODE_ENV=production

# Alternativa SOLO para desarrollo local: quitar DATABASE_URL y usar NODE_ENV=development.
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=yesems_db
# DB_USER=postgres
# DB_PASSWORD=tu_password
JWT_SECRET=usa_un_secreto_largo_y_aleatorio

# Solo para crear el primer administrador en una base de datos nueva.
# Después del primer despliegue elimina INITIAL_ADMIN_PASSWORD de Render.
INITIAL_ADMIN_NAME=Nombre
INITIAL_ADMIN_LASTNAME=Apellido
INITIAL_ADMIN_EMAIL=admin@tudominio.com
INITIAL_ADMIN_PASSWORD=una_contrasena_segura_de_al_menos_8_caracteres

# Al configurar estas tres variables en Render, los comprobantes y PDFs
# se guardarán de forma permanente en Cloudinary.
CLOUDINARY_CLOUD_NAME=tu_cloud_name
CLOUDINARY_API_KEY=tu_api_key
CLOUDINARY_API_SECRET=tu_api_secret
